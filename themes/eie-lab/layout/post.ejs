<article class="article">
  <header class="article-header">
    <p class="eyebrow"><%= page.date.format('YYYY.MM.DD') %></p>
    <h1><%= page.title %></h1>
  </header>
  <div class="article-body">
    <%- page.content %>
  </div>
</article>

<%
  const isNotesPost = page.categories && page.categories.toArray().some(function(category) {
    return category.name === 'Notes';
  });
%>
<% if (isNotesPost && page.comments !== false) { %>
  <%- partial('_partial/comments') %>
<% } %>
