<!doctype html>
<html lang="<%= config.language || 'zh-CN' %>">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="<%= config.description || '' %>">
  <title><% if (page.title) { %><%= page.title %> | <% } %><%= config.title %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Noto+Serif+SC:wght@400;500;700;900&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="<%- url_for('/css/site.css') %>?v=20260903-spoiler-1">
  <% if (page.math) { %>
    <script>
      window.MathJax = {
        tex: {
          inlineMath: [['\\(', '\\)'], ['$', '$']],
          displayMath: [['\\[', '\\]'], ['$$', '$$']]
        },
        options: { skipHtmlTags: ['script', 'noscript', 'style', 'textarea', 'pre', 'code'] }
      };
    </script>
    <script defer src="https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js"></script>
  <% } %>
</head>
<body>
  <div class="site-shell">
    <header class="site-header">
      <a class="brand" href="<%- url_for('/') %>" aria-label="<%= config.title %>">
        <span class="brand-mark">C</span>
        <span>
          <strong><%= config.title %></strong>
          <small>notes, boards, life</small>
        </span>
      </a>
      <nav class="nav" aria-label="Main navigation">
        <a href="<%- url_for('/') %>">首页</a>
        <a href="<%- url_for('/notes/') %>">笔记</a>
        <a href="<%- url_for('/pcb/') %>">PCB</a>
        <a href="<%- url_for('/life/') %>">生活</a>
        <a href="<%- url_for('/archives/') %>">归档</a>
      </nav>
    </header>

    <div class="site-layout">
      <%- partial('_partial/author-card') %>

      <div class="content-column">
        <main class="page-enter">
          <%- body %>
        </main>

        <footer class="site-footer">
          <div>
            <strong><%= config.title %></strong>
            <span>Engineering notes and personal fragments.</span>
          </div>
          <div class="site-badges" aria-label="Site status badges">
            <a class="site-badge is-hexo" href="https://hexo.io/" target="_blank" rel="noopener" title="Built with Hexo">
              <b><span class="badge-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 2.5 20.2 7v10L12 21.5 3.8 17V7L12 2.5Z"/><path d="M8.5 8.2v7.6M15.5 8.2v7.6M8.5 12h7"/></svg></span>Engine</b><em>Hexo 8</em>
            </a>
            <a class="site-badge is-pages" href="https://pages.github.com/" target="_blank" rel="noopener" title="Hosted on GitHub Pages">
              <b><span class="badge-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M6.5 7.5a3 3 0 1 0 0 .1M17.5 7.5a3 3 0 1 0 0 .1M12 17.5a3 3 0 1 0 0 .1"/><path d="M8.8 8.9 12 15M15.2 8.9 12 15"/></svg></span>Deploy</b><em>GitHub Pages</em>
            </a>
            <a class="site-badge is-repo" href="https://github.com/Lee520150/Lee520150.github.io" target="_blank" rel="noopener" title="View site repository">
              <b><span class="badge-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M8 18.5c-3.2 1-3.2-1.4-4.5-1.8M16 22v-3.1c0-.9-.3-1.5-.8-1.9 2.8-.3 5.8-1.4 5.8-6.2 0-1.4-.5-2.5-1.3-3.4.1-.3.6-1.7-.1-3.4 0 0-1.1-.3-3.5 1.3a12 12 0 0 0-6.2 0C7.5 3.7 6.4 4 6.4 4c-.7 1.7-.2 3.1-.1 3.4A4.8 4.8 0 0 0 5 10.8c0 4.8 3 5.9 5.8 6.2-.4.3-.7.9-.8 1.7V22"/></svg></span>Source</b><em>Repository</em>
            </a>
            <a class="site-badge is-field" href="<%- url_for('/notes/') %>" title="Electronic Information Engineering notes">
              <b><span class="badge-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M4 12h4l2-5 4 10 2-5h4"/><path d="M4 5h3M4 19h3M17 5h3M17 19h3"/></svg></span>Field</b><em>EIE Lab</em>
            </a>
            <a class="site-badge is-license" href="https://creativecommons.org/licenses/by-nc-sa/4.0/" target="_blank" rel="noopener" title="Creative Commons BY-NC-SA 4.0">
              <b><span class="badge-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M10.2 9.6a3 3 0 1 0 0 4.8M16.2 9.6a3 3 0 1 0 0 4.8"/></svg></span>License</b><em>BY-NC-SA 4.0</em>
            </a>
          </div>
          <a href="<%- url_for('/about/') %>">About</a>
        </footer>
      </div>
    </div>
  </div>
</body>
</html>
