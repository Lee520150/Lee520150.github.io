<!doctype html>
<html lang="<%= config.language || 'zh-CN' %>">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="<%= config.description || '' %>">
  <title><% if (page.title) { %><%= page.title %> | <% } %><%= config.title %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Noto+Serif+SC:wght@400;500;700;900&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="<%- url_for('/css/site.css') %>?v=20260831-responsive-sidebar-1">
</head>
<body>
  <div class="site-shell">
    <header class="site-header">
      <a class="brand" href="<%- url_for('/') %>" aria-label="<%= config.title %>">
        <span class="brand-mark">C</span>
        <span>
          <strong><%= config.title %></strong>
          <small>notes, boards, life</small>
        </span>
      </a>
      <nav class="nav" aria-label="Main navigation">
        <a href="<%- url_for('/') %>">首页</a>
        <a href="<%- url_for('/notes/') %>">笔记</a>
        <a href="<%- url_for('/pcb/') %>">PCB</a>
        <a href="<%- url_for('/projects/') %>">项目</a>
        <a href="<%- url_for('/life/') %>">生活</a>
        <a href="<%- url_for('/photos/') %>">摄影</a>
        <a href="<%- url_for('/archives/') %>">归档</a>
      </nav>
    </header>

    <div class="site-layout">
      <%- partial('_partial/author-card') %>

      <div class="content-column">
        <main class="page-enter">
          <%- body %>
        </main>

        <footer class="site-footer">
          <div>
            <strong><%= config.title %></strong>
            <span>Engineering notes and personal fragments.</span>
          </div>
          <a href="<%- url_for('/about/') %>">About</a>
        </footer>
      </div>
    </div>
  </div>
</body>
</html>
