<article class="article page-article">
  <header class="article-header">
    <p class="eyebrow">Section</p>
    <h1><%= page.title %></h1>
  </header>
  <div class="article-body">
    <%- page.content %>
  </div>
</article>

<section class="section-posts">
  <div class="section-heading">
    <p class="eyebrow">Posts</p>
    <h2><%= page.section_category || page.title %>文章</h2>
  </div>
  <div class="post-list">
    <%
      const categoryName = page.section_category || page.title;
      const posts = site.posts.sort('date', -1).toArray().filter(function(post) {
        return post.categories && post.categories.toArray().some(function(category) {
          return category.name === categoryName;
        });
      });
    %>
    <% if (posts.length) { %>
      <% posts.forEach(function(post) { %>
        <article class="post-card">
          <time datetime="<%= post.date.format('YYYY-MM-DD') %>"><%= post.date.format('YYYY.MM.DD') %></time>
          <h3><a href="<%- url_for(post.path) %>"><%= post.title %></a></h3>
          <p><%= strip_html(post.excerpt || post.content).replace(/\s+/g, ' ').substring(0, 118) %></p>
        </article>
      <% }) %>
    <% } else { %>
      <article class="post-card empty-card">
        <h3>还没有文章</h3>
        <p>以后选择这个板块创建文章后，会自动显示在这里。</p>
      </article>
    <% } %>
  </div>
</section>
