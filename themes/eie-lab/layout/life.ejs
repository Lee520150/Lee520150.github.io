<section class="life-hero">
  <p class="eyebrow">Life Archive</p>
  <h1>生活</h1>
  <p>摄影、模型、随笔和日常观察。这里先做成横向抽拉卡片，之后每张卡都可以换成你的照片、作品图或者专题入口。</p>
</section>

<section class="section-posts">
  <div class="section-heading">
    <p class="eyebrow">Posts</p>
    <h2>生活文章</h2>
  </div>
  <div class="post-list">
    <%
      const posts = site.posts.sort('date', -1).toArray().filter(function(post) {
        return post.categories && post.categories.toArray().some(function(category) {
          return category.name === 'Life';
        });
      });
    %>
    <% if (posts.length) { %>
      <% posts.forEach(function(post) { %>
        <article class="post-card">
          <time datetime="<%= post.date.format('YYYY-MM-DD') %>"><%= post.date.format('YYYY.MM.DD') %></time>
          <h3><a href="<%- url_for(post.path) %>"><%= post.title %></a></h3>
          <p><%= strip_html(post.excerpt || post.content).replace(/\s+/g, ' ').substring(0, 118) %></p>
        </article>
      <% }) %>
    <% } else { %>
      <article class="post-card empty-card">
        <h3>还没有文章</h3>
        <p>以后选择生活板块创建文章后，会自动显示在这里。</p>
      </article>
    <% } %>
  </div>
</section>

<section class="life-slider" aria-label="life sections">
  <a class="life-card photo-card" href="<%- url_for('/photos/') %>">
    <div class="life-art">
      <span class="shape circle"></span>
      <span class="shape bar"></span>
    </div>
    <div class="life-copy">
      <span>Photography</span>
      <h2>摄影</h2>
      <p>生活随拍、城市、校园、器材记录，或者单独整理成图文日志。</p>
    </div>
  </a>

  <article class="life-card model-card">
    <div class="life-art">
      <span class="shape block"></span>
      <span class="shape line"></span>
    </div>
    <div class="life-copy">
      <span>Model</span>
      <h2>模型</h2>
      <p>模型制作、涂装过程、成品照片、材料和工具记录。</p>
    </div>
  </article>

  <article class="life-card essay-card">
    <div class="life-art">
      <span class="shape disc"></span>
      <span class="shape rail"></span>
    </div>
    <div class="life-copy">
      <span>Notes</span>
      <h2>随笔</h2>
      <p>不属于课程、不属于项目，但你想长期保存的想法。</p>
    </div>
  </article>
</section>
